# Grok + JEV research desk — configuration
# Copy to .env (the installer does this) and fill in what you need.
# Every value is optional: with nothing set the desk runs offline-safe,
# deterministic research and prints cards to the console.

# --- LLM (Grok by default; any OpenAI-compatible endpoint works) -----------
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.20-non-reasoning
# Examples:
#   Ollama    : LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=...  LLM_MODEL=x-ai/grok-4
# Run Grok on every auto-signal before it is sent (costs tokens):
LLM_IN_LOOP=false

# --- Telegram ----------------------------------------------------------------
# Bot token from @BotFather. Operator ids = numeric Telegram user ids allowed
# to press YES / NO / LATE and to send commands (comma separated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_IDS=
# Where cards are sent (comma separated chat ids; a group id is negative).
# Defaults to the operator ids (direct messages).
TELEGRAM_BROADCAST_CHAT_IDS=

# --- Risk & signal policy -----------------------------------------------------
RISK_PER_TRADE_USD=100
# UTC hours when the desk stays flat (no cards, no executions). "off" disables.
DEAD_ZONE_UTC=20-24
MIN_LATE_RR=1.2
RUNAWAY_FRACTION=0.55
SIGNAL_MIN_SCORE=68
SIGNAL_MIN_NEWS_SUPPORT=65
SIGNAL_COOLDOWN_MIN=45
SIGNAL_MAX_AGE_MIN=25
# Assets that may raise automatic cards (GOLD, GBPUSD, BTC). "none" = only /eval.
AUTO_ASSETS=GOLD,GBPUSD

# --- Execution ------------------------------------------------------------------
# paper   : local JSON ledger only (default)
# webhook : POST approved orders to your own executor, HMAC-signed
EXECUTION_MODE=paper
EXECUTION_WEBHOOK_URL=
EXECUTION_WEBHOOK_SECRET=

# --- Storage & cadence ----------------------------------------------------------
JEVDESK_DATA_DIR=data
MARKET_POLL_S=30
NEWS_POLL_S=60
PREDICTIONS_POLL_S=120
